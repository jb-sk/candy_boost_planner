{
  "name": "candy-boost-planner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.0",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src/ tests/ scripts/",
    "build": "pnpm run lint && pnpm run typecheck && vite build && pnpm run verify:runtime-bundle",
    "preview": "vite preview",
    "generate:terms": "node scripts/generate-terms.mjs",
    "generate:tables": "node scripts/generate-pokesleep-tables.mjs",
    "generate:pokemon-db": "node scripts/generate-pokemon-db.mjs",
    "generate:master": "node scripts/generate-master.mjs",
    "generate:pokemon-master": "pnpm run generate:master -- --interactive",
    "generate:pokemon-en-names": "node scripts/generate-pokemon-en-names.mjs",
    "generate:candy-families": "node scripts/generate-candy-families.mjs",
    "generate:events": "node scripts/generate-events.mjs",
    "generate:full-moon-dates": "node scripts/generate-full-moon-dates.mjs",
    "generate:event-names-en": "node scripts/generate-event-names-en.mjs",
    "check:event-names-en": "node scripts/generate-event-names-en.mjs --list-pending",
    "verify:events": "node scripts/generate-events.mjs --verify",
    "verify:full-moon-dates": "node scripts/generate-full-moon-dates.mjs --verify",
    "verify:runtime-bundle": "node scripts/verify-runtime-bundle.mjs",
    "set:boost": "node scripts/set-boost-config.mjs",
    "update:all": "node scripts/update-all.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:tests",
    "typecheck:app": "vue-tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "vue-tsc -p tsconfig.test.json --noEmit",
    "test:level-planner:oracle-random": "vitest run tests/unit/level-planner/full-plan-oracle.test.ts --configLoader runner",
    "verify:level-planner": "node scripts/level-planner-verifier.mjs",
    "bench:level-planner": "vitest bench tests/bench/level-planner.bench.ts",
    "perf:interaction": "playwright test tests/perf/interaction.perf.spec.ts --config playwright.perf.config.ts",
    "perf:cls": "playwright test tests/perf/layout-shift.perf.spec.ts --config playwright.perf.config.ts",
    "verify:forms": "node scripts/verify-form-mapping.mjs",
    "verify:candy-families": "node scripts/generate-candy-families.mjs --verify",
    "check:ingredient-labels": "node scripts/check-ingredient-labels.mjs"
  },
  "dependencies": {
    "vue": "^3.5.39",
    "vue-i18n": "^11.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "astronomy-engine": "2.1.19",
    "cheerio": "^1.2.0",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.12"
  }
}
